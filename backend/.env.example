# Copy to backend/.env and load before running Flask:
#   set -a && source .env && set +a
# Or export each variable manually.

# ── GCP project ───────────────────────────────────────────────────────────────
PROJECT_ID=ferrous-store-487916-f8

# ── BigQuery — all tables are in ASSIGNEMENT2 ─────────────────────────────────
DATASET_ID=ASSIGNEMENT2
MOVIES_TABLE=movies
RATINGS_TABLE=ratings
LINKS_TABLE=links

# ── BigQuery ML ───────────────────────────────────────────────────────────────
# Model lives in the same ASSIGNEMENT2 dataset.
BQML_MODEL_NAME=first_MF_model

# ── Similar-users tuning ──────────────────────────────────────────────────────
SIMILAR_USER_MIN_RATING_IM=0.7
SIMILAR_USERS_TOP_K=10

# ── Elasticsearch (Elastic Cloud) ─────────────────────────────────────────────
ES_ENDPOINT=https://your-cluster-id.us-central1.gcp.cloud.es.io:443
ES_API_KEY=your-api-key-here
